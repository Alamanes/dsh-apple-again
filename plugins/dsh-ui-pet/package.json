{
  "name": "dsh-ui-pet",
  "version": "1.1.0",
  "private": true,
  "description": "虚拟宠物：把 Codex 格式的宠物包养进 DSH 左下角，优先读取 ~/.dsh/pets，读不到再退回 ~/.codex/pets。（dsh-ui-suite 组件）",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ui-suite",
    "pet",
    "codex-pet"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": {
      "default": "./locale/*.json"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "license": "MIT"
}

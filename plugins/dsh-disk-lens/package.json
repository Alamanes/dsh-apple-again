{
  "name": "dsh-disk-lens",
  "version": "0.6.0",
  "private": true,
  "icon": "./icon.png",
  "description": "盘面：右侧边栏的只读磁盘面板，扫描与清理都在主对话里由模型调用工具完成。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alamanes/dsh-apple-again.git",
    "directory": "plugins/dsh-disk-lens"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "disk",
    "cleanup",
    "storage",
    "sidebar"
  ],
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": {
      "default": "./locale/*.json"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "locale",
    "icon.png",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "license": "MIT"
}
